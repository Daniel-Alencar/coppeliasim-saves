Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Mapa de ocupação (inflado)
      Enabled: true
      Topic:
        Value: /youbot/grid
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6
      Draw Behind: true
    - Class: rviz_default_plugins/Path
      Name: Caminho A*
      Enabled: true
      Topic:
        Value: /youbot/path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 0; 200; 255
      Line Width: 0.03
      Pose Style: Axes
      Axes Length: 0.1
      Axes Radius: 0.01
    - Class: rviz_default_plugins/PoseArray
      Name: Bananas
      Enabled: true
      Topic:
        Value: /youbot/bananas
        Durability Policy: Transient Local
      Shape: Arrow (Flat)
      Color: 255; 220; 0
    - Class: rviz_default_plugins/PoseArray
      Name: Poops
      Enabled: true
      Topic:
        Value: /youbot/poops
        Durability Policy: Transient Local
      Shape: Arrow (Flat)
      Color: 150; 90; 40
    - Class: rviz_default_plugins/Pose
      Name: Waypoint atual
      Enabled: true
      Topic:
        Value: /youbot/goal
      Shape: Arrow
      Color: 0; 255; 0
      Shaft Length: 0.2
      Shaft Radius: 0.03
      Head Length: 0.1
      Head Radius: 0.06
    - Class: rviz_default_plugins/Pose
      Name: Robô
      Enabled: true
      Topic:
        Value: /youbot/pose
      Shape: Axes
      Axes Length: 0.3
      Axes Radius: 0.02
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.4
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 100
      X: 0
      Y: 0
